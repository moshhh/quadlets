[Unit]
Description=Chrome for Karakeep
After=karakeep.service network-online.target
Requires=karakeep.service

[Container]
Image=gcr.io/zenika-hub/alpine-chrome:124
ContainerName=karakeep_chrome
Exec=--no-sandbox --disable-gpu --disable-dev-shm-usage --remote-debugging-address=0.0.0.0 --remote-debugging-port=9222 --hide-scrollbars
Network=main

[Service]
Restart=Always
TimeoutStartSec=900

[Install]
WantedBy=default.target
